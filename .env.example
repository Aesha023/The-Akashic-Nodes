# ──────────────────────────────────────────────────────────────
# PravahX — Environment variables
# Copy to .env and fill in the values. NEVER commit .env itself.
# ──────────────────────────────────────────────────────────────
# ── Repository ───────────────────────────────────────────────
# Link to the source repository
PRAVAHX_REPO_URL=https://github.com/Aesha023/The-Akashic-Nodes

# ── Deployment mode ──────────────────────────────────────────
# "full" (default) | "showcase" (read-only, no workers, banner)
PRAVAHX_DEPLOYMENT_MODE=full

# "online" | "secure" (no outbound network)
PRAVAHX_SECURE_MODE=online

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=pravahx
POSTGRES_USER=
POSTGRES_PASSWORD=
# Separate role for Alembic migrations (higher privilege)
POSTGRES_MIGRATION_USER=
POSTGRES_MIGRATION_PASSWORD=

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage (S3-compatible / MinIO) ───────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_ARTIFACTS=pravahx-artifacts
S3_BUCKET_EXPORTS=pravahx-exports
S3_REGION=us-east-1

# ── Security ─────────────────────────────────────────────────
# Secret key for signing tokens (generate a strong random value)
SECRET_KEY=
# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google Earth Engine (Phase 6) ────────────────────────────
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_FILE=
GEE_PROJECT_ID=

# ── Elevation data (Phase 1) ────────────────────────────────
# If Copernicus GLO-30 needs credentials
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ── Email notifications (Phase 10, optional) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Webhook notifications (Phase 10, optional) ──────────────
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Observability (optional) ─────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_PASSWORD=

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1

# ── GPU / DualSPHysics (Phase 3) ────────────────────────────
# "cpu" | "remote_gpu" | "precomputed"
DUALSPHYSICS_MODE=cpu
# For remote GPU mode
DUALSPHYSICS_REMOTE_HOST=
DUALSPHYSICS_REMOTE_USER=
DUALSPHYSICS_REMOTE_KEY_FILE=
# For precomputed import mode
DUALSPHYSICS_IMPORT_DIR=
